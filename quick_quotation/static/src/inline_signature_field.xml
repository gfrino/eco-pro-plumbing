<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="quick_quotation.InlineSignatureField">
        <div class="border rounded bg-white w-100" style="height: 250px; position: relative; box-shadow: inset 0 2px 5px rgba(0,0,0,0.05);">
            <canvas t-ref="canvas" style="width: 100%; height: 100%; touch-action: none; cursor: crosshair;"></canvas>
            
            <div t-if="!props.record.data[props.name]" class="position-absolute w-100 text-center text-muted" style="top: 50%; transform: translateY(-50%); pointer-events: none;">
                <i class="fa fa-pencil fa-2x mb-2 text-primary" style="opacity: 0.5;"></i><br/>
                Draw your signature here
            </div>
            
            <button t-if="props.record.data[props.name] and !props.readonly" class="btn btn-sm btn-light position-absolute top-0 end-0 m-2 shadow-sm" t-on-click="clearSignature" title="Clear Signature">
                <i class="fa fa-trash text-danger"></i> Clear
            </button>
        </div>
    </t>
</templates>
