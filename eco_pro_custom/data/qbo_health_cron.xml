<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="qbo_health_alert_email_param" model="ir.config_parameter">
            <field name="key">eco_pro_custom.qbo_health.alert_email</field>
            <field name="value">odoo@ticinoweb.net</field>
        </record>

        <record id="qbo_health_check_cron" model="ir.cron">
            <field name="name">Eco Pro: QuickBooks sync health check (alert by email)</field>
            <field name="model_id" ref="quickbooks_sync_online.model_quickbooks_integration"/>
            <field name="state">code</field>
            <field name="code">model.eco_pro_qbo_health_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
