<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_job_location" inherit_id="account.report_invoice_document">
        <xpath expr="//strong[text()='Shipping Address']" position="replace">
            <strong class="d-block mt-3">Job Location</strong>
        </xpath>
    </template>

    <record id="view_move_form_eco_pro" model="ir.ui.view">
        <field name="name">account.move.form.eco.pro</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_cc_fee" string="Add Credit Card Fees" type="object" class="oe_highlight" invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="string">Job Location</attribute>
            </xpath>
        </field>
    </record>
</odoo>
