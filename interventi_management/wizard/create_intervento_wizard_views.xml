<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_intervento_wizard_form" model="ir.ui.view">
        <field name="name">create.intervento.wizard.form</field>
        <field name="model">create.intervento.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Job Request">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="date"/>
                    <field name="date_end"/>
                    <field name="is_whole_day"/>
                    <field name="notes" widget="text"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_create_intervento" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_intervento_wizard" model="ir.actions.act_window">
        <field name="name">Create Job Request</field>
        <field name="res_model">create.intervento.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
