<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_interventi" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.interventi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_interventi"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar"
                    invisible="intervento_count == 0">
                    <field name="intervento_count" widget="statinfo" string="Job Requests"/>
                </button>
            </div>
            <xpath expr="//header" position="inside">
                <button name="action_create_intervento" 
                        string="Create Job Request" 
                        type="object" 
                        class="btn-secondary" 
                        invisible="intervento_count != 0"/>
            </xpath>
        </field>
    </record>
</odoo>
