<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="companycam_photo_view_kanban" model="ir.ui.view">
        <field name="name">companycam.photo.kanban</field>
        <field name="model">companycam.photo</field>
        <field name="arch" type="xml">
            <kanban class="o_companycam_photo_kanban" sample="1" quick_create="false">
                <field name="has_annotation"/>
                <field name="media_type"/>
                <field name="dual_camera"/>
                <field name="has_location"/>
                <templates>
                    <t t-name="card" class="p-0 o_companycam_card">
                        <div class="o_companycam_thumb">
                            <field name="image_annotated_512" widget="image" invisible="not has_annotation"
                                   options="{'img_class': 'o_companycam_thumb_img'}"/>
                            <field name="image_512" widget="image" invisible="has_annotation"
                                   options="{'img_class': 'o_companycam_thumb_img'}"/>
                            <span t-if="record.media_type.raw_value == 'video'" class="o_companycam_play" title="Video">
                                <i class="fa fa-play" role="img" aria-label="Video"/>
                            </span>
                            <div class="o_companycam_thumb_badges">
                                <span t-if="record.has_annotation.raw_value" class="badge text-bg-warning" title="Has markup">
                                    <i class="fa fa-pencil" role="img" aria-label="Has markup"/>
                                </span>
                                <span t-if="record.dual_camera.raw_value" class="badge text-bg-info" title="Dual camera">
                                    <i class="fa fa-clone" role="img" aria-label="Dual camera"/>
                                </span>
                                <span t-if="record.has_location.raw_value" class="badge text-bg-dark" title="Location saved">
                                    <i class="fa fa-map-marker" role="img" aria-label="Location saved"/>
                                </span>
                            </div>
                            <field name="starred" widget="boolean_favorite" nolabel="1" class="o_companycam_star"/>
                        </div>
                        <div class="px-2 py-2">
                            <div class="fw-bold text-truncate">
                                <field name="project_id"/>
                                <span t-if="!record.project_id.raw_value" class="text-muted fw-normal fst-italic">No project</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small text-muted">
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <span class="ms-auto"><field name="captured_at" widget="datetime" options="{'show_seconds': False}"/></span>
                            </div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="companycam_photo_view_list" model="ir.ui.view">
        <field name="name">companycam.photo.list</field>
        <field name="model">companycam.photo</field>
        <field name="arch" type="xml">
            <list string="Photos and videos" sample="1">
                <field name="image_128" widget="image" options="{'size': [48, 48]}" string=" "/>
                <field name="name"/>
                <field name="media_type" widget="badge"/>
                <field name="project_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="captured_at" options="{'show_seconds': False}"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="has_annotation" string="Markup" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="companycam_photo_view_form" model="ir.ui.view">
        <field name="name">companycam.photo.form</field>
        <field name="model">companycam.photo</field>
        <field name="arch" type="xml">
            <form string="Photo">
                <header>
                    <button name="action_companycam_annotate" type="object" string="Markup" class="btn-primary"
                            icon="fa-pencil" invisible="media_type != 'photo' or not image_1920 or not id"/>
                    <button name="action_companycam_remove_annotation" type="object" string="Remove markup"
                            invisible="not has_annotation"
                            confirm="Remove the markup? The original photo stays as it is."/>
                    <button name="action_companycam_create_gallery" type="object" string="Share" icon="fa-share-alt"
                            invisible="not id"/>
                    <button name="action_companycam_print_report" type="object" string="Print" icon="fa-print"
                            invisible="not id"/>
                </header>
                <sheet>
                    <field name="has_annotation" invisible="1"/>
                    <field name="has_location" invisible="1"/>
                    <div class="o_companycam_form_media">
                        <field name="video_file" widget="companycam_video" readonly="1"
                               invisible="media_type != 'video' or not video_file"/>
                        <field name="image_annotated" widget="image" readonly="1"
                               invisible="media_type != 'photo' or not has_annotation"
                               options="{'zoom': True, 'preview_image': 'image_annotated_512', 'img_class': 'o_companycam_form_img'}"/>
                        <field name="image_1920" widget="image"
                               invisible="media_type != 'photo' or has_annotation"
                               options="{'zoom': True, 'preview_image': 'image_1024', 'img_class': 'o_companycam_form_img'}"/>
                    </div>
                    <div class="oe_title">
                        <h1 class="d-flex align-items-center gap-2">
                            <field name="starred" widget="boolean_favorite" nolabel="1"/>
                            <field name="name" placeholder="e.g. Kitchen wall before demolition"/>
                        </h1>
                    </div>
                    <field name="description" placeholder="Add a caption: what does this photo show?"/>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_quick_create': True}"
                                   placeholder="No project: choose one to file this photo"/>
                            <field name="partner_id" invisible="not partner_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"
                                   placeholder="Before, After, Damage..."/>
                            <field name="media_type" widget="radio" options="{'horizontal': True}"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="captured_at"/>
                            <label for="latitude" string="Location"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="latitude" class="w-auto" nolabel="1"/>
                                <field name="longitude" class="w-auto" nolabel="1"/>
                                <field name="map_url" widget="url" text="Open map" nolabel="1" invisible="not has_location"/>
                            </div>
                            <field name="video_file" filename="video_filename" string="Video file"
                                   invisible="media_type != 'video'"/>
                            <field name="video_filename" invisible="1"/>
                            <field name="video_duration" invisible="media_type != 'video' or not video_duration"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook invisible="not has_annotation">
                        <page name="original" string="Original photo">
                            <field name="image_1920" widget="image" readonly="1"
                                   options="{'zoom': True, 'preview_image': 'image_512', 'img_class': 'o_companycam_form_img_small'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="companycam_photo_view_search" model="ir.ui.view">
        <field name="name">companycam.photo.search</field>
        <field name="model">companycam.photo</field>
        <field name="arch" type="xml">
            <search string="Photos and videos">
                <field name="name" string="Title or caption" filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                <field name="project_id"/>
                <field name="partner_id" string="Customer"/>
                <field name="tag_ids"/>
                <field name="user_id"/>
                <filter name="my_captures" string="My captures" domain="[('user_id', '=', uid)]"/>
                <filter name="starred" string="Starred" domain="[('starred', '=', True)]"/>
                <filter name="no_project" string="Without project" domain="[('project_id', '=', False)]"/>
                <separator/>
                <filter name="photos" string="Photos" domain="[('media_type', '=', 'photo')]"/>
                <filter name="videos" string="Videos" domain="[('media_type', '=', 'video')]"/>
                <filter name="annotated" string="With markup" domain="[('has_annotation', '=', True)]"/>
                <separator/>
                <filter name="filter_captured_at" string="Captured on" date="captured_at"/>
                <group>
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_user" string="Captured by" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_day" string="Day" context="{'group_by': 'captured_at:day'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'media_type'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
