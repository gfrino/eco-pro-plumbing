<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_companycam" model="res.groups.privilege">
        <field name="name">CompanyCam</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_companycam_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Takes photos and videos, adds markup and shares galleries.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_companycam"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_companycam_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Also manages photo tags and can delete any photo.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_companycam"/>
        <field name="implied_ids" eval="[(4, ref('group_companycam_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="companycam_photo_rule_company" model="ir.rule">
        <field name="name">CompanyCam photo: multi-company</field>
        <field name="model_id" ref="model_companycam_photo"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="companycam_gallery_rule_company" model="ir.rule">
        <field name="name">CompanyCam gallery: multi-company</field>
        <field name="model_id" ref="model_companycam_gallery"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!-- The team works together on every capture (tags, captions, markup, comments),
         but users may delete only their own captures; administrators can delete anything -->
    <record id="companycam_photo_rule_user_own" model="ir.rule">
        <field name="name">CompanyCam photo: users delete their own captures</field>
        <field name="model_id" ref="model_companycam_photo"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_companycam_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="companycam_photo_rule_user_read" model="ir.rule">
        <field name="name">CompanyCam photo: users see and edit all captures</field>
        <field name="model_id" ref="model_companycam_photo"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_companycam_user'))]"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="companycam_photo_rule_manager" model="ir.rule">
        <field name="name">CompanyCam photo: administrators delete everything</field>
        <field name="model_id" ref="model_companycam_photo"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_companycam_manager'))]"/>
    </record>
</odoo>
