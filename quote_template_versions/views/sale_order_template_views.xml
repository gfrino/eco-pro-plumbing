<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_template_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.form.inherit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="string">Good</attribute>
            </xpath>
            
            <xpath expr="//field[@name='sale_order_template_line_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='sale_order_template_line_ids']" position="after">
                <field name="good_line_ids" widget="section_and_note_one2many" mode="tree,kanban" context="{'default_version': 'good'}">
                    <list string="Good Lines" editable="bottom">
                        <control>
                            <create name="add_product_control" string="Add a product"/>
                            <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                            <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                        </control>
                        <field name="display_type" column_invisible="True"/>
                        <field name="sequence" widget="handle"/>
                        <field name="product_id"/>
                        <field name="name" widget="section_and_note_text"/>
                        <field name="product_uom_qty"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                        <field name="version" column_invisible="True"/>
                    </list>
                </field>
            </xpath>

            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Better" name="better_lines">
                    <field name="better_line_ids" widget="section_and_note_one2many" mode="tree,kanban" context="{'default_version': 'better'}">
                        <list string="Better Lines" editable="bottom">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                                <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="display_type" column_invisible="True"/>
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name" widget="section_and_note_text"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="version" column_invisible="True"/>
                        </list>
                    </field>
                </page>
                <page string="Best" name="best_lines">
                    <field name="best_line_ids" widget="section_and_note_one2many" mode="tree,kanban" context="{'default_version': 'best'}">
                        <list string="Best Lines" editable="bottom">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                                <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="display_type" column_invisible="True"/>
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name" widget="section_and_note_text"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="version" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
